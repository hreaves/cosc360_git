#!/bin/sh 

dir=/home/mrjantz/cs360/labs/Lab-2-Famtree
ge="$dir/Gradescript-Examples"

if [ $# -ne 0 ]; then
  echo 'usage: gradeall' >&2
  exit 1
fi

enum=1
n=0
while [ $enum -le 100 ]; do
  out=`valgrind --leak-check=full --error-exitcode=1 $dir/gradescript $enum 2>&1 | head -n 1`
  echo $out
  n=`echo $n $out | awk '{ print $1 + ($NF == "correct.") }'`

  rm -f tmp-???-test-stdout.txt tmp-???-test-stderr.txt tmp-???-correct-stdout.txt tmp-???-correct-stderr.txt tmp-???-grader.txt

  enum=`echo $enum | awk '{ print $1+1 }'`
done

echo ""

echo "$n Correct out of 100"
